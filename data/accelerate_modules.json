    "html": "<div class=\"c-discover-more-2 o-module no-bottom-margin\">\n<div class=\"o-layout-container\">\n<h2 class=\"c-discover-more-2__title\">How we’re making an impact </h2>\n<div class=\"c-discover-more-2__grid\">\n<a class=\"c-discover-more-2__item\" href=\"/stories/2024/03/our-programme-has-transformed-communities/\" style=\"flex:1\">\n<div class=\"c-discover-more-2__image c-tease-card__image\">\n<img alt=\"A female community drug distributor measures a girl to see how much medication she needs to protect her from trachoma.\" src=\"/wp-content/uploads/2024/03/2302_Sightsavers-cdd-sarah-measures-child-mda-accelerate-programme-kenya-300x169.jpg\" srcset=\"/wp-content/uploads/2024/03/2302_Sightsavers-cdd-sarah-measures-child-mda-accelerate-programme-kenya-1024x575.jpg 2x, /wp-content/uploads/2024/03/2302_Sightsavers-cdd-sarah-measures-child-mda-accelerate-programme-kenya-300x169.jpg 1x\"/>\n</div>\n<div class=\"c-discover-more-2__icon\">\n<svg alt=\"stories article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Sightsavers stories</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#892853\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M20.09,32.83c-7.07,0-12.83-5.75-12.83-12.83s5.75-12.83,12.83-12.83,12.83,5.75,12.83,12.83c0,2.77-.86,5.38-2.48,7.59l1.28,3.82c.13.39.03.81-.26,1.1-.29.29-.71.39-1.11.26l-4.26-1.43c-1.84.97-3.9,1.49-6,1.49ZM30.29,31.89h0,0ZM20.09,8.67c-6.25,0-11.33,5.08-11.33,11.33s5.08,11.33,11.33,11.33c1.95,0,3.87-.5,5.55-1.45.18-.1.41-.13.61-.06l3.77,1.26-1.13-3.39c-.08-.24-.04-.5.12-.7,1.58-2.01,2.41-4.43,2.41-6.99,0-6.25-5.08-11.33-11.33-11.33Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M24.01,18.59h-7.84c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.84c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n<path d=\"M20.09,23.08h-3.92c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h3.92c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n</svg>\n</div>\n<div class=\"c-discover-more-2__card-content\">\n<div class=\"c-discover-more-2__title-link\">\n<!-- add acf flag to show/hide taxonomy tags -->\n<!-- end -->\n<h3 class=\"c-discover-more-2__card-header\">“Our programme has transformed communities”</h3>\n</div>\n<p class=\"c-discover-more-2__card-description\">The Accelerate programme has already delivered 53 million treatments to protect people from trachoma, and managed 91,000 advanced cases of the disease.</p>\n</div>\n</a>\n<a class=\"c-discover-more-2__item\" href=\"/blogs/2023/04/my-ted-talk-helped-to-protect-millions-of-people-from-trachoma/\" style=\"flex:1\">\n<div class=\"c-discover-more-2__image c-tease-card__image\">\n<img alt=\"Sightsavers CEO CAroline Harper during her TED Talk, standing in front of large red letters spelling TED.\" src=\"/wp-content/uploads/2019/04/sightsavers_52616977300-300x200.jpg\" srcset=\"/wp-content/uploads/2019/04/sightsavers_52616977300-1024x683.jpg 2x, /wp-content/uploads/2019/04/sightsavers_52616977300-300x200.jpg 1x\"/>\n</div>\n<div class=\"c-discover-more-2__icon\">\n<svg alt=\"blog article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<g>\n<title>Sightsavers blog</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#fb2\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M18.3,12.44h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n<path d=\"M15.18,16.93h-4.27c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h4.27c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n<path d=\"M30.85,25.6h-4.56c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h4.56c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n<path d=\"M30.85,30.09h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n</g>\n<path d=\"M27.44,10.27l-15.97,15.97c-.19.19-.32.43-.37.7l-1.09,4.65,4.65-1.09c.26-.05.51-.18.7-.37l15.97-15.97c.76-.76.76-2,0-2.76l-1.12-1.12c-.76-.76-2-.76-2.76,0Z\" fill=\"#892853\" stroke-width=\"0\"></path>\n</svg>\n</div>\n<div class=\"c-discover-more-2__card-content\">\n<div class=\"c-discover-more-2__title-link\">\n<!-- add acf flag to show/hide taxonomy tags -->\n<!-- end -->\n<h3 class=\"c-discover-more-2__card-header\">How my TED talk helped to protect millions of people from trachoma</h3>\n</div>\n<p class=\"c-discover-more-2__card-description\">In 2018, Sightsavers CEO Caroline Harper took to the TED stage to talk about the importance of eliminating trachoma.</p>\n</div>\n</a>\n<a class=\"c-discover-more-2__item\" href=\"/?p=57706\" style=\"flex:1\">\n<div class=\"c-discover-more-2__image c-tease-card__image\">\n<img alt=\"The view from the deck of a boat, with a sunset and land in the distance.\" src=\"/wp-content/uploads/2021/06/Sightsavers-Guinea-Bissau-Bijagos-Islands-MDA-trip-300x169.jpg\" srcset=\"/wp-content/uploads/2021/06/Sightsavers-Guinea-Bissau-Bijagos-Islands-MDA-trip-1024x575.jpg 2x, /wp-content/uploads/2021/06/Sightsavers-Guinea-Bissau-Bijagos-Islands-MDA-trip-300x169.jpg 1x\"/>\n</div>\n<div class=\"c-discover-more-2__icon\">\n<svg alt=\"stories article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Sightsavers stories</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#892853\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M20.09,32.83c-7.07,0-12.83-5.75-12.83-12.83s5.75-12.83,12.83-12.83,12.83,5.75,12.83,12.83c0,2.77-.86,5.38-2.48,7.59l1.28,3.82c.13.39.03.81-.26,1.1-.29.29-.71.39-1.11.26l-4.26-1.43c-1.84.97-3.9,1.49-6,1.49ZM30.29,31.89h0,0ZM20.09,8.67c-6.25,0-11.33,5.08-11.33,11.33s5.08,11.33,11.33,11.33c1.95,0,3.87-.5,5.55-1.45.18-.1.41-.13.61-.06l3.77,1.26-1.13-3.39c-.08-.24-.04-.5.12-.7,1.58-2.01,2.41-4.43,2.41-6.99,0-6.25-5.08-11.33-11.33-11.33Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M24.01,18.59h-7.84c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.84c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n<path d=\"M20.09,23.08h-3.92c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h3.92c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n</svg>\n</div>\n<div class=\"c-discover-more-2__card-content\">\n<div class=\"c-discover-more-2__title-link\">\n<!-- add acf flag to show/hide taxonomy tags -->\n<!-- end -->\n<h3 class=\"c-discover-more-2__card-header\">“Trachoma: go! We don’t want you!”</h3>\n</div>\n<p class=\"c-discover-more-2__card-description\">A video diary recorded by Sightsavers programme officer Iliezer Gomes Bidjonque gives a unique look at how we're tackling trachoma on the remote Bijagos Islands in Guinea-Bissau.</p>\n</div>\n</a>\n</div>\n</div>\n</div>"
  }
