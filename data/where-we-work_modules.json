    "html": "<div class=\"c-discover-more o-module no-bottom-margin\">\n<div class=\"o-layout-container\">\n<h2 class=\"c-discover-more__title\">Read about our latest work</h2>\n<div class=\"c-discover-more__grid\" data-columns=\"\">\n<div class=\"c-tease-card c-tease-card--story\">\n<a class=\"c-tease-card__image\" href=\"/stories/2026/09/its-important-the-community-sees-us-as-their-own/\" target=\"_self\">\n<img alt=\"Volunteers, who are holding dose poles, gather before a community drug campaign.\" src=\"/wp-content/uploads/2026/09/2607_Sightsavers-cdd-volunteers-momade-mozambique-ntds-hero-580x326.jpg\"/>\n</a>\n<div class=\"c-tease-card__content\">\n<svg alt=\"stories article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Sightsavers stories</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#892853\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M20.09,32.83c-7.07,0-12.83-5.75-12.83-12.83s5.75-12.83,12.83-12.83,12.83,5.75,12.83,12.83c0,2.77-.86,5.38-2.48,7.59l1.28,3.82c.13.39.03.81-.26,1.1-.29.29-.71.39-1.11.26l-4.26-1.43c-1.84.97-3.9,1.49-6,1.49ZM30.29,31.89h0,0ZM20.09,8.67c-6.25,0-11.33,5.08-11.33,11.33s5.08,11.33,11.33,11.33c1.95,0,3.87-.5,5.55-1.45.18-.1.41-.13.61-.06l3.77,1.26-1.13-3.39c-.08-.24-.04-.5.12-.7,1.58-2.01,2.41-4.43,2.41-6.99,0-6.25-5.08-11.33-11.33-11.33Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M24.01,18.59h-7.84c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.84c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n<path d=\"M20.09,23.08h-3.92c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h3.92c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n</svg>\n<div class=\"c-tease-card__taxonomy--story\">\n<a class=\"c-tease-card__tag\" href=\"/category/stories/\" target=\"_self\">Stories</a> <span class=\"c-tease-card__tag-separator\">/</span>\n<a class=\"c-tease-card__tag\" href=\"/category/fighting-disease/\" target=\"_self\">Fighting disease</a>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<h3 class=\"c-tease-card__header\">\n<a href=\"/stories/2026/09/its-important-the-community-sees-us-as-their-own/\" target=\"_self\">“It’s important the community sees us as their own”</a>\n</h3>\n<p class=\"c-tease-card__preview\">In September, Sightsavers reached a major milestone by helping to deliver two billion treatments to protect people from diseases.</p>\n</div>\n</div>\n<div class=\"c-tease-card c-tease-card--story\">\n<a class=\"c-tease-card__image\" href=\"/stories/2026/09/action-stories-from-ghana/\" target=\"_self\">\n<img alt=\"A cameraman walks backwards to capture a woman walking down a road. She is carrying a container on her head.\" src=\"/wp-content/uploads/2026/09/2512_Sightsavers-filming-bbcstoryworks-film-lf-ghana-580x326.jpg\"/>\n</a>\n<div class=\"c-tease-card__content\">\n<svg alt=\"stories article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Sightsavers stories</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#892853\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M20.09,32.83c-7.07,0-12.83-5.75-12.83-12.83s5.75-12.83,12.83-12.83,12.83,5.75,12.83,12.83c0,2.77-.86,5.38-2.48,7.59l1.28,3.82c.13.39.03.81-.26,1.1-.29.29-.71.39-1.11.26l-4.26-1.43c-1.84.97-3.9,1.49-6,1.49ZM30.29,31.89h0,0ZM20.09,8.67c-6.25,0-11.33,5.08-11.33,11.33s5.08,11.33,11.33,11.33c1.95,0,3.87-.5,5.55-1.45.18-.1.41-.13.61-.06l3.77,1.26-1.13-3.39c-.08-.24-.04-.5.12-.7,1.58-2.01,2.41-4.43,2.41-6.99,0-6.25-5.08-11.33-11.33-11.33Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M24.01,18.59h-7.84c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.84c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n<path d=\"M20.09,23.08h-3.92c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h3.92c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n</svg>\n<div class=\"c-tease-card__taxonomy--story\">\n<a class=\"c-tease-card__tag\" href=\"/category/stories/\" target=\"_self\">Stories</a> <span class=\"c-tease-card__tag-separator\">/</span>\n<a class=\"c-tease-card__tag\" href=\"/category/fighting-disease/\" target=\"_self\">Fighting disease</a>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<h3 class=\"c-tease-card__header\">\n<a href=\"/stories/2026/09/action-stories-from-ghana/\" target=\"_self\">“And action!”: Stories from Ghana</a>\n</h3>\n<p class=\"c-tease-card__preview\">Sightsavers’ Jo Glyde goes behind the scenes during the making of our film about lymphatic filariasis with BBC StoryWorks.</p>\n</div>\n</div>\n<div class=\"c-tease-card c-tease-card--story\">\n<a class=\"c-tease-card__image\" href=\"/stories/2026/09/invest-in-women-the-sabi-woman-project/\" target=\"_self\">\n<img alt=\"Saudat, wearing a grey hijab, smiles broadly.\" src=\"/wp-content/uploads/2026/09/2602_Sightsavers-Nigeria-SABI-womens-project-Saudat_mobile-hero-580x326.png\"/>\n</a>\n<div class=\"c-tease-card__content\">\n<svg alt=\"stories article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Sightsavers stories</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#892853\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M20.09,32.83c-7.07,0-12.83-5.75-12.83-12.83s5.75-12.83,12.83-12.83,12.83,5.75,12.83,12.83c0,2.77-.86,5.38-2.48,7.59l1.28,3.82c.13.39.03.81-.26,1.1-.29.29-.71.39-1.11.26l-4.26-1.43c-1.84.97-3.9,1.49-6,1.49ZM30.29,31.89h0,0ZM20.09,8.67c-6.25,0-11.33,5.08-11.33,11.33s5.08,11.33,11.33,11.33c1.95,0,3.87-.5,5.55-1.45.18-.1.41-.13.61-.06l3.77,1.26-1.13-3.39c-.08-.24-.04-.5.12-.7,1.58-2.01,2.41-4.43,2.41-6.99,0-6.25-5.08-11.33-11.33-11.33Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M24.01,18.59h-7.84c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.84c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n<path d=\"M20.09,23.08h-3.92c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h3.92c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n</svg>\n<div class=\"c-tease-card__taxonomy--story\">\n<a class=\"c-tease-card__tag\" href=\"/category/stories/\" target=\"_self\">Stories</a> <span class=\"c-tease-card__tag-separator\">/</span>\n<a class=\"c-tease-card__tag\" href=\"/category/women-and-girls/\" target=\"_self\">Women and girls</a>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<h3 class=\"c-tease-card__header\">\n<a href=\"/stories/2026/09/invest-in-women-the-sabi-woman-project/\" target=\"_self\">Invest in women: the SABI-Woman project</a>\n</h3>\n<p class=\"c-tease-card__preview\">In Nigeria, Saudat now runs her own business after taking part in a Sightsavers-supported programme.</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"c-discover-more__button-wrapper o-layout-container\">\n<a class=\"c-btn\" href=\"/category/stories/\">Read more stories from Africa and Asia</a>\n</div>\n</div>"
