    "html": "<div class=\"c-cta-basic o-module\">\n<div class=\"c-cta-basic__inner o-layout-container\">\n<div class=\"c-cta-basic__content\">\n<p class=\"\">Your donation today could help change lives</p>\n<a class=\"c-btn c-btn--pay cta-no-image js-donate-link\" href=\"https://donate.sightsavers.org/detect?gb_appeal=web2026uk&amp;global_appeal=web2026gl\" id=\"cta\"><span>DONATE</span></a>\n</div>\n</div>\n</div>"
