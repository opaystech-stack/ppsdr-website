    "html": "<div class=\"c-discover-more o-module\">\n<div class=\"o-layout-container\">\n<div class=\"c-discover-more__grid\" data-columns=\"\">\n<div class=\"c-tease-card c-tease-card--news\">\n<a class=\"c-tease-card__image\" href=\"/news/2026/10/sightsavers-launches-partnership-to-accelerate-disease-elimination-in-africa/\" target=\"_self\">\n<img alt=\"A boy drinks from a cup of water, held by an older woman, after taking medication to treat disease.\" src=\"/wp-content/uploads/2026/09/2502_Sightsavers-ismail-mda-schisto-nigeria-194433-580x326.jpg\">\n</img></a>\n<div class=\"c-tease-card__content\">\n<svg alt=\"news article icon\" class=\"svg-icon svg-cat\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<circle cx=\"20\" cy=\"20\" fill=\"#403b5e\" r=\"20\" stroke-width=\"0\"></circle>\n<rect fill=\"#fb2\" height=\"8.65\" stroke-width=\"0\" width=\"7.72\" x=\"10.03\" y=\"11.35\"></rect>\n<path d=\"M28.38,23.88H10.14c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h18.23c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,27.51H10.14c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h18.23c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,13.02h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,16.64h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,20.26h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n</svg>\n<div class=\"c-tease-card__taxonomy--news\">\n<a class=\"c-tease-card__tag\" href=\"/category/news/\" target=\"_self\">News</a> <span class=\"c-tease-card__tag-separator\">/</span>\n<a class=\"c-tease-card__tag\" href=\"/category/fighting-disease/\" target=\"_self\">Fighting disease</a>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<h3 class=\"c-tease-card__header\">\n<a href=\"/news/2026/10/sightsavers-launches-partnership-to-accelerate-disease-elimination-in-africa/\" target=\"_self\">Sightsavers launches strategic partnership to accelerate disease elimination in Africa</a>\n</h3>\n<p class=\"c-tease-card__preview\">Sightsavers and AUDA-NEPAD will strengthen African-led efforts to eliminate neglected tropical diseases.</p>\n<div class=\"c-tease-card__info\">October 2026</div>\n</div>\n</div>\n<div class=\"c-tease-card c-tease-card--news\">\n<a class=\"c-tease-card__image\" href=\"/news/2026/09/sightsavers-cbm-call-for-child-vision-and-hearing-care-investment-across-africa/\" target=\"_self\">\n<img alt=\"Five men and women sit on a stage during an event. A man in the centre is speaking into a microphone.\" src=\"/wp-content/uploads/2026/09/2609_Sightsavers-cbm-roundtable-event-UNGA-official-580x326.jpg\"/>\n</a>\n<div class=\"c-tease-card__content\">\n<svg alt=\"news article icon\" class=\"svg-icon svg-cat\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<circle cx=\"20\" cy=\"20\" fill=\"#403b5e\" r=\"20\" stroke-width=\"0\"></circle>\n<rect fill=\"#fb2\" height=\"8.65\" stroke-width=\"0\" width=\"7.72\" x=\"10.03\" y=\"11.35\"></rect>\n<path d=\"M28.38,23.88H10.14c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h18.23c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,27.51H10.14c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h18.23c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,13.02h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,16.64h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,20.26h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n</svg>\n<div class=\"c-tease-card__taxonomy--news\">\n<a class=\"c-tease-card__tag\" href=\"/category/news/\" target=\"_self\">News</a> <span class=\"c-tease-card__tag-separator\">/</span>\n<a class=\"c-tease-card__tag\" href=\"/category/eye-health/\" target=\"_self\">Eye health</a>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<h3 class=\"c-tease-card__header\">\n<a href=\"/news/2026/09/sightsavers-cbm-call-for-child-vision-and-hearing-care-investment-across-africa/\" target=\"_self\">Sightsavers and CBM call for child vision and hearing care investment</a>\n</h3>\n<p class=\"c-tease-card__preview\">The two organisations made the call at a roundtable event as part of the UN General Assembly.</p>\n<div class=\"c-tease-card__info\">September 2026</div>\n</div>\n</div>\n<div class=\"c-tease-card c-tease-card--news\">\n<a class=\"c-tease-card__image\" href=\"/news/2026/06/sightsavers-to-co-host-event-on-disability-and-climate-justice/\" target=\"_self\">\n<img alt=\"A muddy track leads through tall grasses to a single-storey building.\" src=\"/wp-content/uploads/2026/06/2509_Sightsavers-school-in-sierra-leone-212637-580x326.jpg\"/>\n</a>\n<div class=\"c-tease-card__content\">\n<svg alt=\"news article icon\" class=\"svg-icon svg-cat\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<circle cx=\"20\" cy=\"20\" fill=\"#403b5e\" r=\"20\" stroke-width=\"0\"></circle>\n<rect fill=\"#fb2\" height=\"8.65\" stroke-width=\"0\" width=\"7.72\" x=\"10.03\" y=\"11.35\"></rect>\n<path d=\"M28.38,23.88H10.14c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h18.23c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,27.51H10.14c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h18.23c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,13.02h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,16.64h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M28.38,20.26h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n</svg>\n<div class=\"c-tease-card__taxonomy--news\">\n<a class=\"c-tease-card__tag\" href=\"/category/news/\" target=\"_self\">News</a> <span class=\"c-tease-card__tag-separator\">/</span>\n<a class=\"c-tease-card__tag\" href=\"/category/disability-and-inclusion/\" target=\"_self\">Disability and inclusion</a>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<h3 class=\"c-tease-card__header\">\n<a href=\"/news/2026/06/sightsavers-to-co-host-event-on-disability-and-climate-justice/\" target=\"_self\">Sightsavers to co-host event on disability and climate justice</a>\n</h3>\n<p class=\"c-tease-card__preview\">The panel event will explore how climate action and economic systems can better include people with disabilities and informal workers.</p>\n<div class=\"c-tease-card__info\">June 2026</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"c-discover-more__button-wrapper o-layout-container\">\n<a class=\"c-btn\" href=\"/stories-news-blogs/\">Read more stories, news and blogs </a>\n</div>\n</div>"
