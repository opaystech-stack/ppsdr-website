    "html": "<div class=\"c-text-block-wrapper o-module c-text-block--right\">\n<div class=\"o-layout-container\">\n<div class=\"o-content c-text-block c-text-block--third\">\n<h3>You’re important to us</h3>\n<p>Sightsavers is committed to transparency and accountability. We aim to be open, frank and honest about all our work, and we make sure we explain everything we do so our supporters know how their money is being spent.</p>\n<p>Our <a href=\"/how-were-run/accountability-and-transparency/speakup/\">Speak Up reporting platform</a> is a global way of reporting improper conduct, either online or by phone, and enables beneficiaries, employees, volunteers, partners and more to raise concerns about the conduct of Sightsavers and its staff.</p>\n</div>\n<div class=\"c-side-modules c-side-modules--third c-side-modules--right\">\n<div class=\"c-promo-block\">\n<div class=\"c-promo-block__content\">\n<h2 class=\"c-promo-block__title\">Our policies</h2>\n<p class=\"c-promo-block__description\"><a href=\"/wp-content/uploads/2025/09/January-2025_Sightsavers-Global-complaints-policy.pdf\" target=\"_blank\">Download our complaints policy</a><br/><a href=\"/wp-content/uploads/2018/06/Sightsavers-Supporter-Promise-and-Privacy-Policy-February-2018.pdf\" target=\"_blank\">Download our privacy policy</a></p>\n</div>\n</div>\n</div>\n</div>\n</div>"
  },
