    "html": "<div class=\"c-icon-block o-module c-ip-block--grey no-bottom-margin\">\n<div class=\"o-layout-container\">\n<h2 class=\"c-icon-block__title\">Our offices around the world</h2>\n<div class=\"c-icon-block__scroll-overlay\">\n<div class=\"c-icon-block__scroll-wrap\">\n<div class=\"c-icon-block__content\" data-mobile-scroll-inner=\"\">\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Africa (East, Central and Southern)</h3>\n<p>One Padmore Place<br>\nThird Floor, Wing B<br/>\nGeorge Padmore Road<br/>\nKilimani, Nairobi, Kenya</br></p>\n<p><b>Telephone:</b> +254 722 973180<br/>\n<b>Email: </b><a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#70151303113003191718040311061502035e1f0217\" target=\"Select\"><span class=\"__cf_email__\" data-cfemail=\"a5c0c6d6c4e5d6ccc2cdd1d6c4d3c0d7d68bcad7c2\">[email protected]</span></a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Africa (West)</h3>\n<p>Rue des Ambassadeurs<br/>\nVilla Becam 9 bis<br/>\nFann Résidence<br/>\nDakar<br/>\nSénégal</p>\n<p><b>Telephone:</b> +221 33 869 4538<br/>\n<b>Email: </b><a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#cfb8aebda0a2aea6a38fbca6a8a7bbbcaeb9aabdbce1a0bda8\" target=\"Select\"><span class=\"__cf_email__\" data-cfemail=\"255244574a48444c4965564c424d515644534057560b4a5742\">[email protected]</span></a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Bangladesh/South Asia</h3>\n<p>House 1/B (5th floor)<br/>\nRoad 8, Block – I<br/>\nBanani, Dhaka<br/>\n1213<br/>\nBangladesh</p>\n<p><b>Telephone:</b> +880 222 2270 966<br/>\n<b>Fax:</b> 008802 8826580</p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">India (head office)</h3>\n<p>45 Okhla Industrial Estate<br/>\nPhase III<br/>\nNew Delhi 110 020<br/>\nIndia</p>\n<p><b>Telephone:</b> +91 11 42267202,<br/>\n+91 11 42384572<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#7353000603031c010706001a1d171a1233001a141b070012051601001a1d171a125d1c0114\" target=\"Select\"> supportusindia@<br/>\nsightsaversindia.org</a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">India (South)</h3>\n<p>A-3 Shivdham<br/>\nNew Link Road, Kanchpada<br/>\nMalad (west), Mumbai 400 064<br/>\nIndia</p>\n<p><b>Telephone:</b> +91 222 882 1919<br/>\n<b>Fax:</b> 00 91 22 28826363<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#a989dadcd9d9c6dbdddcdac0c7cdc0c8e9dac0cec1dddac8dfccdbdac0c7cdc0c887c6dbce\" target=\"Select\"> supportusindia@<br/>\nsightsaversindia.org</a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Ireland</h3>\n<p>305 The Capel<br/>\nBuilding<br/>\nMary’s Abbey<br/>\nDublin 7, D07 RD25<br/>\nIreland</p>\n<p><b>Telephone:</b> +353 (0)1 663 7666<br/>\n<b>Fax:</b> 00 91 22 28826363<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#c0e0a9aea6af80b3a9a7a8b4b3a1b6a5b2b3eea9a5e0\" target=\"Select\"> <span class=\"__cf_email__\" data-cfemail=\"b3daddd5dcf3c0dad4dbc7c0d2c5d6c1c09ddad6\">[email protected]</span> </a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Italy</h3>\n<p>Corso Italia 1<br/>\n20122 Milano (MI), Italy</p>\n<p><b>Telephone:</b> +39 02 8738 0935<br/>\n<b>Fax:</b> +39 02 87381148<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#c8e8a1bca9a4a1a988bba1afa0bcbba9beadbabbe6a7baafe8\" target=\"Select\"> <span class=\"__cf_email__\" data-cfemail=\"402934212c29210033292728343321362532336e2f3227\">[email protected]</span> </a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Middle East</h3>\n<p>Office 138, Building 4<br/>\nInternational Humanitarian City<br/>\nPO Box 506021, Dubai, UAE</p>\n<p><b>Telephone:</b> +971 (0)4 242 8356<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#49693c282c093a202e213d3a283f2c3b3a67263b2e69\" target=\"Select\"> <span class=\"__cf_email__\" data-cfemail=\"f0859195b08399979884839186958283de9f8297\">[email protected]</span> </a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Norway</h3>\n<p>Sightsavers, Aluvegen 95<br/>\n2319 HAMAR<br/>\nNorway</p>\n<p><b>Telephone:</b> +47 401 63 771<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#b595c6dcd2ddc1c6d4c3d0c7c6f5dac7d2c6c0c5c5dac7c19bdbda\" target=\"Select\"> <span class=\"__cf_email__\" data-cfemail=\"2a59434d425e594b5c4f58596a45584d595f5a5a45585e044445\">[email protected]</span></a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Pakistan</h3>\n<p>Office No 3-A<br/>\nStreet No 7<br/>\nRabbani Market, G-10/2<br/>\nIslamabad, Pakistan</p>\n<p><b>Telephone:</b> +92 (0)51 215 7010<br/>\n<b>Fax:</b> +92 (0)51 215 7011</p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">Sweden</h3>\n<p>Mantella AB<br/>\nSkeppsmyrevägen 7<br/>\n141 40 Huddinge<br/>\nSweden</p>\n<p><b>Telephone:</b> +46 (8) 528 00 299<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#5a7a33343c351a29333d322e293b2c3f282974293f7a\" target=\"Select\"> <span class=\"__cf_email__\" data-cfemail=\"5930373f36192a303e312d2a382f3c2b2a772a3c\">[email protected]</span></a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">United Kingdom</h3>\n<p><strong>Registered address (please<br/>\ndo not send correspondence)</strong><br/>\n35 Perrymount Road<br/>\nHaywards Heath, RH16 3BW</p>\n<p><b>Telephone:</b> +44 (0)1444 446 600<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#2a0a43444c456a59434d425e594b5c4f58590445584d0a\" target=\"Select\"> <span class=\"__cf_email__\" data-cfemail=\"70191e161f3003191718040311061502035e1f0217\">[email protected]</span> </a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<h3 class=\"c-icon-block__heading\">United States</h3>\n<p>One Boston Place, Suite 2600<br/>\nBoston, MA 02108<br/>\nUnited States</p>\n<p><b>Telephone:</b> +1 (800) 707 9746<br/>\n<b>Email:</b> <a class=\"pinklink\" href=\"/cdn-cgi/l/email-protection#fada93949c95ba89939d928e899b8c9f88898f899bd495889dda\" target=\"Select\"> <span class=\"__cf_email__\" data-cfemail=\"20494e464f6053494748545341564552535553410e4f5247\">[email protected]</span> </a></p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>"
