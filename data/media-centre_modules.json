    "html": "<div class=\"c-icon-block o-module c-ip-block--white no-bottom-margin\">\n<div class=\"o-layout-container\">\n<h2 class=\"c-icon-block__title\"><strong>Key media contacts</strong> </h2>\n<div class=\"c-icon-block__scroll-overlay\">\n<div class=\"c-icon-block__scroll-wrap\">\n<div class=\"c-icon-block__content\" data-mobile-scroll-inner=\"\">\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-4\" data-mobile-scroll-card=\"\">\n<img \"\"=\"\" alt=\"\" class=\"c-icon-card__image\" src=\"/wp-content/uploads/2025/05/Sightsavers-people-sitting-at-table-icon-left-01.svg\">\n<h3 class=\"c-icon-block__heading\">Head of media</h3>\n<p><strong>Maria Gandara</strong><br/>\n+44 (0)1444 225 550<br/>\n<a href=\"/cdn-cgi/l/email-protection#177a7076797376657657647e707f6364766172656439786570\"><span class=\"__cf_email__\" data-cfemail=\"fc919b9d92989d8e9dbc8f959b94888f9d8a998e8fd2938e9b\">[email protected]</span></a></p>\n</img></div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-4\" data-mobile-scroll-card=\"\">\n<img \"\"=\"\" alt=\"\" class=\"c-icon-card__image\" src=\"/wp-content/uploads/2024/09/icon-glasses-left-yellow.svg\">\n<h3 class=\"c-icon-block__heading\">Eye health</h3>\n<p><strong>Jenny Murray-Cox</strong><br/>\n+44 (0)1444 275 150<br/>\n<a href=\"/cdn-cgi/l/email-protection#7f15120a0d0d1e061c10073f0c1618170b0c1e091a0d0c51100d18\"><span class=\"__cf_email__\" data-cfemail=\"8be1e6fef9f9eaf2e8e4f3cbf8e2ece3fff8eafdeef9f8a5e4f9ec\">[email protected]</span></a></p>\n</img></div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-4\" data-mobile-scroll-card=\"\">\n<img \"\"=\"\" alt=\"\" class=\"c-icon-card__image\" src=\"/wp-content/uploads/2024/09/icon-left-wheelchair-yellow.svg\"/>\n<h3 class=\"c-icon-block__heading\">Inclusion</h3>\n<p><strong>Julius Omokhunu</strong><br/>\n+234 (0)803 970 1280<br/>\n<a href=\"/cdn-cgi/l/email-protection#294346444642415c475c695a404e415d5a485f4c5b5a07465b4e\"><span class=\"__cf_email__\" data-cfemail=\"fa9095979591928f948fba89939d928e899b8c9f8889d495889d\">[email protected]</span></a></p>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-2 o-grid__d-4\" data-mobile-scroll-card=\"\">\n<img alt=\"Illustration of medication\" class=\"c-icon-card__image\" src=\"/wp-content/uploads/2024/09/icon-left-medicine-yellow.svg\"/>\n<h3 class=\"c-icon-block__heading\">NTDs</h3>\n<p><strong>Joanna Glyde</strong><br/>\n+44 (0)1444 275 146<br/>\n<a href=\"/cdn-cgi/l/email-protection#503a373c2934351023393738242331263522237e3f2237\"><span class=\"__cf_email__\" data-cfemail=\"a4cec3c8ddc0c1e4d7cdc3ccd0d7c5d2c1d6d78acbd6c3\">[email protected]</span></a></p>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>"
