    "html": "<div class=\"c-cta-basic o-module\">\n<div class=\"c-cta-basic__inner o-layout-container\">\n<div class=\"c-cta-basic__content\">\n<p class=\"\">Help more communities access vital treatment</p>\n<a class=\"c-btn c-btn--pay cta-no-image js-donate-link\" href=\"https://donate.sightsavers.org/detect?gb_appeal=ec0326uk&amp;global_appeal=ec0326gl\" id=\"cta\"><span>DONATE</span></a>\n</div>\n</div>\n</div>"
