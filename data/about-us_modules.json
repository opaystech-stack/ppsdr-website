    "style": "",
    "html": "<div>\n<div class=\"no-bottom-margin o-module\">\n<div class=\"c-interactive-image\" data-alt=\"A global map showing multiple countries in Africa and Asia highlighted.\" data-description=\"Sightsavers has a presence in more than 30 countries in Africa and Asia. We work closely with local and national governments, and recruit local volunteers to help us carry out our work within the community.\" data-heading=\"Where we work\" data-hotspots='[{\"acf_clickable_image_hotspot_label\":\"West Africa\",\"acf_clickable_image_hotspot_description\":\"Our work in west Africa is overseen from our regional office in Senegal, with project offices in individual countries.\",\"acf_clickable_image_hotspot_positions\":{\"acf_clickable_image_hotspot_positions_left\":\"5\",\"acf_clickable_image_hotspot_positions_top\":\"55\",\"acf_clickable_image_hotspot_positions_position_override\":\"right\"}},{\"acf_clickable_image_hotspot_label\":\"East, central and southern Africa\",\"acf_clickable_image_hotspot_description\":\"Sightsavers\\u2019 earliest work focused on east Africa, and is now coordinated from our regional office in Kenya.\",\"acf_clickable_image_hotspot_positions\":{\"acf_clickable_image_hotspot_positions_left\":\"34\",\"acf_clickable_image_hotspot_positions_top\":\"69\",\"acf_clickable_image_hotspot_positions_position_override\":\"right\"}},{\"acf_clickable_image_hotspot_label\":\"South Asia\",\"acf_clickable_image_hotspot_description\":\"In Asia our work focuses on India, Pakistan and Bangladesh, with regional offices in New Delhi, Mumbai and Dhaka.\",\"acf_clickable_image_hotspot_positions\":{\"acf_clickable_image_hotspot_positions_left\":\"55\",\"acf_clickable_image_hotspot_positions_top\":\"43\",\"acf_clickable_image_hotspot_positions_position_override\":\"right\"}}]' data-image=\"/wp-content/uploads/2025/07/Sightsavers-Map-website-2025-new.svg\" data-numbered=\"\" data-open=\"\" data-theme-link=\"/wp-content/themes/theme//assets/\" id=\"interactive-image_1483357719\"></div>\n</div>\n</div>"
  },
