    "html": "<div class=\"c-icon-block o-module c-ip-block--white no-bottom-margin\">\n<div class=\"o-layout-container\">\n<div class=\"c-icon-block__scroll-overlay\">\n<div class=\"c-icon-block__scroll-wrap\">\n<div class=\"c-icon-block__content\" data-mobile-scroll-inner=\"\">\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-3 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<a class=\"c-icon-card__image-container\" href=\"https://register-of-charities.charitycommission.gov.uk/en/charity-search/-/charity-details/207544/charity-overview\" target=\"_blank\">\n<img \"\"=\"\" alt=\"\" class=\"c-icon-card__image\" src=\"/wp-content/uploads/2024/09/Charity-commission-about-us-bottom-01.svg\"/>\n</a>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-3 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<a class=\"c-icon-card__image-container\" href=\"https://www.fundraisingregulator.org.uk/directory/sightsavers\" target=\"_blank\">\n<img \"\"=\"\" alt=\"\" class=\"c-icon-card__image\" src=\"/wp-content/uploads/2024/09/FR-about-us-01.svg\"/>\n</a>\n</div>\n<div class=\"c-icon-card o-grid__m-1 o-grid__t-3 o-grid__d-3\" data-mobile-scroll-card=\"\">\n<a class=\"c-icon-card__image-container\" href=\"https://disabilityconfident.campaign.gov.uk/\" target=\"_blank\">\n<img \"\"=\"\" alt=\"\" class=\"c-icon-card__image\" src=\"/wp-content/uploads/2024/09/Disability-confident-about-us-small-01.svg\"/>\n</a>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>"
