    "html": "<div class=\"o-module no-bottom-margin\">\n<div class=\"c-hero-fullscreen__video--controls-container\">\n<button class=\"c-btn c-hero-fullscreen__video--close\">\n<div class=\"c-hero-fullscreen__video--controls-close\">\n<svg viewbox=\"0 0 31.113 31.113\" xmlns=\"http://www.w3.org/2000/svg\">\n<g data-name=\"Group 105\" id=\"Group_105\" transform=\"translate(-222.031 -923.481) rotate(45)\">\n<line data-name=\"Line 7\" fill=\"none\" id=\"Line_7\" stroke=\"#8b0047\" stroke-miterlimit=\"10\" stroke-width=\"6\" transform=\"translate(832 477)\" y1=\"38\"></line>\n<line data-name=\"Line 8\" fill=\"none\" id=\"Line_8\" stroke=\"#8b0047\" stroke-miterlimit=\"10\" stroke-width=\"6\" transform=\"translate(813 496)\" x2=\"38\"></line>\n</g>\n</svg>\n</div>\n<span>Close video</span>\n</button>\n</div>\n<div class=\"c-hero-fullscreen\" style=\"background-image: url(/wp-content/uploads/2025/03/2310-Sightsavers-12-year-old-Minahil-in-classroom-in-Islamabad-SHIP-project_CREDIT_Jamshyd-Masud-1400x788.png); background-position: right \">\n<div class=\"c-hero-fullscreen__inner o-layout-container c-hero-fullscreen__inner--align-left\">\n<div class=\"c-hero-fullscreen__content c-hero-fullscreen__content__fullscreen_video\">\n<h1 class=\"c-hero-fullscreen__title\">We start with sight, but we don’t stop there </h1>\n<p class=\"c-hero-fullscreen__sub-title\">At Sightsavers, we protect sight. We eliminate diseases. We fight for equality. And with your support, we can do even more.</p>\n<div class=\"c-hero-fullscreen__video--play--container\">\n<button class=\"c-btn c-hero-fullscreen__video--play\">\n<svg height=\"100px\" version=\"1.1\" viewbox=\"0 0 100 100\" width=\"100px\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\">\n<defs>\n<path d=\"M0,0 L103.874,0 L103.874,103.874 L0,103.874 L0,0 Z M72.186,52.514 L57.219,43.89 L42.319,35.266 L42.319,69.766 L57.219,61.138 L72.186,52.514 Z\" id=\"path-1\"></path>\n</defs>\n<g fill=\"none\" fill-rule=\"evenodd\" id=\"Page-1\" stroke=\"none\" stroke-width=\"1\">\n<g id=\"Sightsavers.org_-_Web_-_Thumbnail_option_–_24\" transform=\"translate(-283.000000, -689.000000)\">\n<g id=\"Group_1\" transform=\"translate(283.000000, 523.000000)\">\n<g id=\"Group-2\" transform=\"translate(0.000000, 166.000000)\">\n<g id=\"Path_1\">\n<mask fill=\"white\" id=\"mask-2\">\n<use xlink:href=\"#path-1\"></use>\n</mask>\n<use fill=\"#FFFFFF\" fill-rule=\"nonzero\" id=\"Combined-Shape\" xlink:href=\"#path-1\"></use>\n</g>\n</g>\n</g>\n</g>\n</g>\n</svg> <span>Watch our video (1 minute)</span>\n</button>\n</div>\n</div>\n</div>\n<div class=\"c-hero-fullscreen__mobile-image\">\n<img alt=\"Minahil, who wears spectacles, smiles broadly as she sits at her classroom desk.\" src=\"/wp-content/uploads/2025/03/2310-Sightsavers-12-year-old-Minahil-in-classroom-in-Islamabad-SHIP-project-centre_CREDIT_Jamshyd-Masud-1024x575.png\">\n</img></div>\n</div>\n<iframe allowfullscreen=\"1\" class=\"c-hero-fullscreen__video--iframe\" frameborder=\"0\" src=\"https://www.youtube.com/embed/RHVtyGoLEv8?showinfo=0&amp;rel=0&amp;iv_load_policy=3&amp;modestbranding=1&amp;playsinline=1&amp;enablejsapi=1\"></iframe>\n</div>"
