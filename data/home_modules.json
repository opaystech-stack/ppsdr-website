    "html": "<div class=\"c-cta-basic o-module no-bottom-margin default\">\n<div class=\"c-cta-basic__inner o-layout-container\">\n<div class=\"c-cta-basic__content\">\n<p class=\"\">This festive season, give a life-changing gift</p>\n<a class=\"c-btn c-btn--outline cta-no-image\" href=\"/appeals/virtual-gift-shop-christmas/\" id=\"cta\"><span>Visit our Christmas gift shop</span></a>\n</div>\n</div>\n</div>"
