    "html": "<div class=\"c-discover-more-2 o-module\">\n<div class=\"o-layout-container\">\n<h2 class=\"c-discover-more-2__title\">Latest news and stories</h2>\n<div class=\"c-discover-more-2__grid\">\n<a class=\"c-discover-more-2__item\" href=\"/stories/2026/08/i-have-so-much-joy-in-my-heart/\" style=\"flex:2\">\n<div class=\"c-discover-more-2__image c-tease-card__image\">\n<img alt=\"Ruth, who is wearing a head scarf, sits in front of a brick wall. Two of her children are sitting next to her.\" src=\"/wp-content/uploads/2026/06/2507_Sightsavers-ruth-smiles-with-children-outside-home-malawi-hero-300x169.jpg\" srcset=\"/wp-content/uploads/2026/06/2507_Sightsavers-ruth-smiles-with-children-outside-home-malawi-hero-1024x575.jpg 2x, /wp-content/uploads/2026/06/2507_Sightsavers-ruth-smiles-with-children-outside-home-malawi-hero-300x169.jpg 1x\"/>\n</div>\n<div class=\"c-discover-more-2__icon\">\n<svg alt=\"stories article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Sightsavers stories</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#892853\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M20.09,32.83c-7.07,0-12.83-5.75-12.83-12.83s5.75-12.83,12.83-12.83,12.83,5.75,12.83,12.83c0,2.77-.86,5.38-2.48,7.59l1.28,3.82c.13.39.03.81-.26,1.1-.29.29-.71.39-1.11.26l-4.26-1.43c-1.84.97-3.9,1.49-6,1.49ZM30.29,31.89h0,0ZM20.09,8.67c-6.25,0-11.33,5.08-11.33,11.33s5.08,11.33,11.33,11.33c1.95,0,3.87-.5,5.55-1.45.18-.1.41-.13.61-.06l3.77,1.26-1.13-3.39c-.08-.24-.04-.5.12-.7,1.58-2.01,2.41-4.43,2.41-6.99,0-6.25-5.08-11.33-11.33-11.33Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M24.01,18.59h-7.84c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.84c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n<path d=\"M20.09,23.08h-3.92c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h3.92c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n</svg>\n</div>\n<div class=\"c-discover-more-2__card-content\">\n<div class=\"c-discover-more-2__title-link\">\n<!-- add acf flag to show/hide taxonomy tags -->\n<div class=\"c-tease-card__taxonomy--story\">\n<span class=\"c-tease-card__tag\">Stories</span> <span class=\"c-tease-card__tag-separator\">/</span>\n<span class=\"c-tease-card__tag\">Disability and inclusion</span>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<!-- end -->\n<h3 class=\"c-discover-more-2__card-header\">“I have so much joy in my heart”</h3>\n</div>\n<p class=\"c-discover-more-2__card-description\">Ruth, who has a visual impairment, was struggling to earn a living. Now she runs several small businesses.</p>\n</div>\n</a>\n<a class=\"c-discover-more-2__item\" href=\"/blogs/2026/08/the-final-stage-of-trachoma-elimination-will-be-the-hardest/\" style=\"flex:1\">\n<div class=\"c-discover-more-2__image c-tease-card__image\">\n<img alt=\"A child in Kenya receives medication to protect them from trachoma.\" src=\"/wp-content/uploads/2024/12/2311_Sightsavers-trachoma-MDA-turkana-kenya-180850-300x169.jpg\" srcset=\"/wp-content/uploads/2024/12/2311_Sightsavers-trachoma-MDA-turkana-kenya-180850-1024x575.jpg 2x, /wp-content/uploads/2024/12/2311_Sightsavers-trachoma-MDA-turkana-kenya-180850-300x169.jpg 1x\"/>\n</div>\n<div class=\"c-discover-more-2__icon\">\n<svg alt=\"blog article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<g>\n<title>Sightsavers blog</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#fb2\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M18.3,12.44h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n<path d=\"M15.18,16.93h-4.27c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h4.27c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n<path d=\"M30.85,25.6h-4.56c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h4.56c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n<path d=\"M30.85,30.09h-7.39c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.39c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#231f20\" stroke-width=\"0\"></path>\n</g>\n<path d=\"M27.44,10.27l-15.97,15.97c-.19.19-.32.43-.37.7l-1.09,4.65,4.65-1.09c.26-.05.51-.18.7-.37l15.97-15.97c.76-.76.76-2,0-2.76l-1.12-1.12c-.76-.76-2-.76-2.76,0Z\" fill=\"#892853\" stroke-width=\"0\"></path>\n</svg>\n</div>\n<div class=\"c-discover-more-2__card-content\">\n<div class=\"c-discover-more-2__title-link\">\n<!-- add acf flag to show/hide taxonomy tags -->\n<div class=\"c-tease-card__taxonomy--blog\">\n<span class=\"c-tease-card__tag\">Blogs</span> <span class=\"c-tease-card__tag-separator\">/</span>\n<span class=\"c-tease-card__tag\">Fighting disease</span>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<!-- end -->\n<h3 class=\"c-discover-more-2__card-header\">How we’re helping to beat trachoma</h3>\n</div>\n<p class=\"c-discover-more-2__card-description\">Our leadership role in trachoma elimination efforts is helping to turn ambition into progress.</p>\n</div>\n</a>\n<a class=\"c-discover-more-2__item\" href=\"/stories/2026/05/through-my-eyes-stories-from-an-eye-health-project/\" style=\"flex:1\">\n<div class=\"c-discover-more-2__image c-tease-card__image\">\n<img alt=\"A smiling woman wearing a Sightsavers T-shirt stands with her hand on her hip.\" src=\"/wp-content/uploads/2026/05/2602_Sightsavers-dorothy-programme-manager-eye-health-kenya-300x169.jpg\" srcset=\"/wp-content/uploads/2026/05/2602_Sightsavers-dorothy-programme-manager-eye-health-kenya-1024x576.jpg 2x, /wp-content/uploads/2026/05/2602_Sightsavers-dorothy-programme-manager-eye-health-kenya-300x169.jpg 1x\"/>\n</div>\n<div class=\"c-discover-more-2__icon\">\n<svg alt=\"stories article icon\" class=\"svg-icon svg-cat\" data-name=\"Layer 1\" id=\"Layer_1\" version=\"1.1\" viewbox=\"0 0 40 40\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Sightsavers stories</title>\n<circle cx=\"20\" cy=\"20\" fill=\"#892853\" r=\"20\" stroke-width=\"0\"></circle>\n<path d=\"M20.09,32.83c-7.07,0-12.83-5.75-12.83-12.83s5.75-12.83,12.83-12.83,12.83,5.75,12.83,12.83c0,2.77-.86,5.38-2.48,7.59l1.28,3.82c.13.39.03.81-.26,1.1-.29.29-.71.39-1.11.26l-4.26-1.43c-1.84.97-3.9,1.49-6,1.49ZM30.29,31.89h0,0ZM20.09,8.67c-6.25,0-11.33,5.08-11.33,11.33s5.08,11.33,11.33,11.33c1.95,0,3.87-.5,5.55-1.45.18-.1.41-.13.61-.06l3.77,1.26-1.13-3.39c-.08-.24-.04-.5.12-.7,1.58-2.01,2.41-4.43,2.41-6.99,0-6.25-5.08-11.33-11.33-11.33Z\" fill=\"#fff\" stroke-width=\"0\"></path>\n<path d=\"M24.01,18.59h-7.84c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h7.84c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n<path d=\"M20.09,23.08h-3.92c-.41,0-.75-.34-.75-.75s.34-.75.75-.75h3.92c.41,0,.75.34.75.75s-.34.75-.75.75Z\" fill=\"#fb2\" stroke-width=\"0\"></path>\n</svg>\n</div>\n<div class=\"c-discover-more-2__card-content\">\n<div class=\"c-discover-more-2__title-link\">\n<!-- add acf flag to show/hide taxonomy tags -->\n<div class=\"c-tease-card__taxonomy--story\">\n<span class=\"c-tease-card__tag\">Stories</span> <span class=\"c-tease-card__tag-separator\">/</span>\n<span class=\"c-tease-card__tag\">Eye health</span>\n<span class=\"c-tease-card__tag-separator\">/</span>\n</div>\n<!-- end -->\n<h3 class=\"c-discover-more-2__card-header\">See it through my eyes </h3>\n</div>\n<p class=\"c-discover-more-2__card-description\">Hear from patients and staff who have seen an eye health programme transform their communities in Kenya.</p>\n</div>\n</a>\n</div>\n<div class=\"c-discover-more-2__button-wrapper\">\n<a class=\"c-btn\" href=\"/stories-news-blogs/\">Read more articles about Sightsavers</a>\n</div>\n</div>\n</div>"
